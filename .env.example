# Copy this file to .env.local and fill in the values there.
# .env.local is git-ignored. Never commit real values or paste them into a chat.

# Your app's ID, shown on https://members.sandbox.is/vibes once an admin approves your app.
SANDBOX_AUTH_CLIENT_ID=

# A long random string that signs your session cookie. Use "Make one for me" on the
# Vibes page, or run: openssl rand -base64 32
SANDBOX_AUTH_CLIENT_SESSION_SECRET=
